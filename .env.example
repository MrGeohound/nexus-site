# =============================================================================
# NEXUS — Variáveis de ambiente (Vite). Copie para ".env" e preencha.
# NUNCA commite o arquivo ".env" com valores reais.
# Todas são OPCIONAIS: o site funciona sem nenhuma delas.
# =============================================================================

# --- Analytics / Pixel -------------------------------------------------------
# Google Analytics 4 (ex.: G-XXXXXXXXXX)
VITE_GA4_ID=
# Google Tag Manager (ex.: GTM-XXXXXXX) — opcional, alternativa ao GA4 direto
VITE_GTM_ID=
# Meta Pixel ID (ex.: 000000000000000)
VITE_META_PIXEL_ID=

# --- Contato / WhatsApp ------------------------------------------------------
# Número internacional só com dígitos (ex.: 5585999999999)
VITE_WHATSAPP_NUMERO=
VITE_CONTATO_EMAIL=contato@siganexus.com.br

# --- Redes sociais -----------------------------------------------------------
VITE_INSTAGRAM_URL=https://instagram.com/siganexus
VITE_LINKEDIN_URL=

# --- Backend de leads / onboarding (opcional) --------------------------------
# Endpoint que recebe POST de leads (JSON). Sem ele, os dados ficam locais.
VITE_LEADS_ENDPOINT=
# Endpoint específico de onboarding (se diferente do de leads)
VITE_ONBOARDING_ENDPOINT=
